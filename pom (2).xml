package de.crystallimit;

import org.bukkit.Bukkit;
import org.bukkit.Material;
import org.bukkit.NamespacedKey;
import org.bukkit.entity.Item;
import org.bukkit.entity.Player;
import org.bukkit.event.EventHandler;
import org.bukkit.event.Listener;
import org.bukkit.event.entity.EntityPickupItemEvent;
import org.bukkit.inventory.ItemStack;
import org.bukkit.inventory.PlayerInventory;
import org.bukkit.inventory.ShapedRecipe;
import org.bukkit.plugin.java.JavaPlugin;

public class CrystalLimit extends JavaPlugin implements Listener {

    private static final int MAX = 6;
    private NamespacedKey recipeKey;

    @Override
    public void onEnable() {
        getServer().getPluginManager().registerEvents(this, this);

        // Vanilla-Rezept entfernen, eigenes hinzufügen
        Bukkit.removeRecipe(NamespacedKey.minecraft("end_crystal"));
        recipeKey = new NamespacedKey(this, "end_crystal_netherite");
        ShapedRecipe r = new ShapedRecipe(recipeKey, new ItemStack(Material.END_CRYSTAL));
        r.shape("NNN", "NEN", "NTN");
        r.setIngredient('N', Material.NETHERITE_INGOT); // 7x
        r.setIngredient('E', Material.ENDER_EYE);
        r.setIngredient('T', Material.GHAST_TEAR);
        Bukkit.addRecipe(r);

        // Überschuss regelmäßig entfernen (Kisten, Shift-Klick, Drag usw.)
        Bukkit.getScheduler().runTaskTimer(this, () -> {
            for (Player p : Bukkit.getOnlinePlayers()) enforce(p);
        }, 10L, 10L);
    }

    @Override
    public void onDisable() {
        Bukkit.removeRecipe(recipeKey);
    }

    private int count(Player p) {
        int n = 0;
        for (ItemStack i : p.getInventory().getContents())
            if (i != null && i.getType() == Material.END_CRYSTAL) n += i.getAmount();
        return n;
    }

    private void enforce(Player p) {
        int total = count(p);
        if (total <= MAX) return;
        int excess = total - MAX;
        PlayerInventory inv = p.getInventory();
        ItemStack[] c = inv.getContents();
        for (int i = c.length - 1; i >= 0 && excess > 0; i--) {
            ItemStack s = c[i];
            if (s == null || s.getType() != Material.END_CRYSTAL) continue;
            int take = Math.min(excess, s.getAmount());
            excess -= take;
            if (take == s.getAmount()) inv.setItem(i, null);
            else { s.setAmount(s.getAmount() - take); inv.setItem(i, s); }
            Item drop = p.getWorld().dropItem(p.getLocation(), new ItemStack(Material.END_CRYSTAL, take));
            drop.setPickupDelay(100);
        }
        p.sendMessage("§cDu kannst nur " + MAX + " End-Kristalle im Inventar haben!");
    }

    @EventHandler(ignoreCancelled = true)
    public void onPickup(EntityPickupItemEvent e) {
        if (!(e.getEntity() instanceof Player p)) return;
        ItemStack st = e.getItem().getItemStack();
        if (st.getType() != Material.END_CRYSTAL) return;
        int space = MAX - count(p);
        if (space >= st.getAmount()) return;
        e.setCancelled(true);
        if (space > 0) { // teilweise aufnehmen
            p.getInventory().addItem(new ItemStack(Material.END_CRYSTAL, space));
            st.setAmount(st.getAmount() - space);
            e.getItem().setItemStack(st);
        } else {
            p.sendActionBar(net.kyori.adventure.text.Component.text("§cMaximal " + MAX + " End-Kristalle!"));
        }
    }
}
